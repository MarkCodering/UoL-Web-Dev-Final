<!DOCTYPE html>
<html lang="en">
  <head><%- include('partials/head') %></head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 bg-black/80 backdrop-blur border-b border-gray-800">
      <nav aria-label="Primary" class="container mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-green-400 font-semibold"><%= site.title %></a>
        <ul class="flex items-center gap-3 text-sm">
          <li><a class="px-3 py-2 rounded bg-gray-800" aria-current="page" href="/">Home</a></li>
          <li><a class="px-3 py-2 rounded hover:bg-gray-800" href="/history">History</a></li>
          <li><a class="px-3 py-2 rounded hover:bg-gray-800" href="/contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1" class="flex-1">
      <section class="container mx-auto px-6 py-20 text-center">
        <h1 class="text-5xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-cyan-500 mb-6">
          Welcome to Taiwan's Internet History Hub
        </h1>
        <p class="max-w-3xl mx-auto text-lg md:text-xl text-gray-300"><%= site.tagline %></p>
        <div class="mt-10 flex items-center justify-center gap-4">
          <a href="/history" class="bg-green-600 hover:bg-green-700 text-white font-semibold px-6 py-3 rounded-full transition">View the Stages</a>
          <a href="/contact" class="bg-cyan-600 hover:bg-cyan-700 text-white font-semibold px-6 py-3 rounded-full transition">Get in Touch</a>
        </div>
      </section>

      <section class="container mx-auto px-6 pb-20 grid gap-6 md:grid-cols-3">
        <% [stages[0], stages[1], stages[2] || stages[3]].forEach(function(s, idx){ if (!s) return; %>
          <article class="bg-gray-900 border border-gray-800 rounded-3xl p-6">
            <h2 class="text-xl font-semibold text-green-300"><%= s.title.split(' — ')[0].replace('Stage','Stage') %></h2>
            <p class="text-gray-400 mt-2"><%= s.period %>: <%= s.summary %></p>
            <a class="mt-4 inline-block text-green-400 hover:text-green-300" href="/history#<%= s.id %>">Learn more →</a>
          </article>
        <% }) %>
      </section>
    </main>

    <footer class="border-t border-gray-800 text-center p-4 text-sm text-gray-500">
      &copy; 2025 Internet Museum. All rights reserved.
    </footer>
  </body>
</html>
